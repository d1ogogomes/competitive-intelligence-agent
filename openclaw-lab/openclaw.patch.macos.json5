// openclaw.patch.macos.json5
// Variante do openclaw.patch.json5 adaptada à máquina macOS do Diogo.
// Diferenças vs o patch do Micael:
//   - paths absolutos reescritos para /Users/diogogomes/...
//   - /usr/bin/chromium substituído por Chromium do macOS ou deixado ao CLI
//   - modelo principal trocado para OpenRouter free tier
//   - qmd (backend de memória) desligado por enquanto (não instalado no Mac)
{
  agents: {
    defaults: {
      workspace: "/Users/diogogomes/Documents/GitHub/2026-ei-aoopii-c26/openclaw-lab/workspace",
      repoRoot: "/Users/diogogomes/Documents/GitHub/2026-ei-aoopii-c26",
      model: {
        // OpenRouter free tier.
        // "openrouter/openrouter/free" = "Free Models Router": OpenRouter rota
        // automaticamente entre os modelos gratuitos que tem disponíveis,
        // o que evita que a config partida quando um modelo específico sai.
        // Fallbacks são outros free routers/modelos que o OpenRouter suporta.
        primary: "openrouter/openrouter/free",
        fallbacks: [
          "openrouter/openrouter/auto",
          "openrouter/owl-alpha"
        ]
      },
      thinkingDefault: "low",
      skills: [
        "browser-automation",
        "ddg-search",
        "github",
        "gh-issues",
        "session-logs",
        "taskflow"
      ],
      memorySearch: {
        enabled: true,
        sources: ["memory", "sessions"],
        extraPaths: [
          "/Users/diogogomes/Documents/GitHub/2026-ei-aoopii-c26/docs"
        ],
        experimental: {
          sessionMemory: true
        },
        sync: {
          onSessionStart: true,
          onSearch: true,
          watch: true,
          watchDebounceMs: 15000,
          intervalMinutes: 0,
          sessions: {
            deltaBytes: 2048,
            deltaMessages: 4
          }
        },
        query: {
          maxResults: 8,
          minScore: 0.22,
          hybrid: {
            enabled: true,
            vectorWeight: 0.65,
            textWeight: 0.35,
            candidateMultiplier: 3,
            mmr: {
              enabled: true,
              lambda: 0.7
            },
            temporalDecay: {
              enabled: true,
              halfLifeDays: 30
            }
          }
        },
        cache: {
          enabled: true,
          maxEntries: 256
        }
      },
      compaction: {
        memoryFlush: {
          enabled: true,
          softThresholdTokens: 4000,
          prompt: "Write any lasting notes to memory/YYYY-MM-DD.md and MEMORY.md when appropriate; reply with NO_REPLY if nothing to store.",
          systemPrompt: "Session nearing compaction. Store durable memories now."
        }
      },
      models: {
        "openrouter/openrouter/free": {
          alias: "or-free",
          params: {
            reasoning: { effort: "low" }
          }
        }
      }
    }
  },
  auth: {
    profiles: {
      "openrouter:default": {
        provider: "openrouter",
        mode: "api_key"
      }
    }
  },
  tools: {
    profile: "full",
    // Estas são as tools que este agente precisa. Nomes têm de bater certo com
    // as tools que o OpenClaw efetivamente expõe — validado por smoke test.
    alsoAllow: [
      "web_search",
      "web_fetch",
      "browser",
      "exec",
      "read",
      "write",
      "edit",
      "memory_search",
      "memory_get"
    ],
    deny: [],
    exec: {
      ask: "off"
    },
    web: {
      search: {
        enabled: true,
        provider: "duckduckgo",
        maxResults: 10,
        timeoutSeconds: 20
      },
      fetch: {
        enabled: true,
        maxChars: 80000,
        maxCharsCap: 200000,
        maxResponseBytes: 500000,
        timeoutSeconds: 30,
        readability: true,
        maxRedirects: 5
      }
    }
  },
  // Memory: mantemos backend default ("markdown") porque qmd não está instalado no Mac.
  // Quando passarmos para Docker voltamos ao backend qmd do patch do Micael.
  memory: {
    citations: "auto"
  },
  plugins: {
    enabled: true,
    deny: [],
    entries: {
      "browser": {
        enabled: true
      },
      "duckduckgo": {
        enabled: true,
        config: {
          webSearch: {
            region: "wt-wt",
            safeSearch: "moderate"
          }
        }
      },
      "openrouter": {
        enabled: true
      },
      "memory-core": {
        enabled: true
      },
      // active-memory e memory-wiki ficam desligados até termos qmd
      "active-memory": {
        enabled: false
      },
      "memory-wiki": {
        enabled: false
      }
    },
    slots: {
      memory: "memory-core"
    }
  },
  skills: {
    allowBundled: [
      "browser-automation",
      "ddg-search",
      "github",
      "gh-issues",
      "session-logs",
      "taskflow",
      "skill-creator"
    ],
    load: {
      // Nada de skills extra locais para já; o Micael tem dirs privados dele.
      extraDirs: [],
      watch: true,
      watchDebounceMs: 1000
    },
    install: {
      nodeManager: "npm"
    },
    limits: {
      maxCandidatesPerRoot: 200,
      maxSkillsLoadedPerSource: 80,
      maxSkillsInPrompt: 18,
      maxSkillsPromptChars: 70000,
      maxSkillFileBytes: 500000
    }
  },
  commands: {
    text: true,
    bash: true,
    config: true,
    mcp: true,
    plugins: true,
    debug: true,
    native: "auto",
    nativeSkills: "auto",
    restart: true,
    ownerDisplay: "raw"
  },
  browser: {
    // No macOS o Chromium / Chrome não estão num caminho fixo. Deixamos o OpenClaw
    // descobrir o binário. Se não houver, o browser skill fica indisponível
    // (não precisamos dele para os primeiros scripts).
    enabled: true,
    headless: true,
    noSandbox: false,
    attachOnly: false,
    defaultProfile: "ei-aoopii-openclaw",
    profiles: {
      "ei-aoopii-openclaw": {
        headless: true,
        driver: "openclaw",
        color: "#2563eb",
        cdpPort: 42718
      }
    }
  },
  mcp: {
    servers: {}
  }
}

{
  agents: {
    defaults: {
      workspace: "/home/micael/Documents/2026-ei-aoopii-c26/openclaw/workspace",
      repoRoot: "/home/micael/Documents/2026-ei-aoopii-c26",
      model: {
        primary: "openai-codex/gpt-5.5",
        fallbacks: [
          "openrouter/google/gemma-4-31b-it:free",
          "openrouter/openrouter/free",
          "openrouter/openrouter/auto",
          "openrouter/owl-alpha"
        ]
      },
      thinkingDefault: "low",
      skills: [
        "agent-browser",
        "agent-browser-core",
        "openclaw-agent-browser-clawdbot",
        "safe-memory-manager",
        "browser-automation",
        "ddg-search",
        "github",
        "gh-issues",
        "humanizer",
        "agentmail",
        "session-logs",
        "taskflow",
        "tmux"
      ],
      memorySearch: {
        enabled: true,
        sources: ["memory", "sessions"],
        extraPaths: [
          "/home/micael/Documents/2026-ei-aoopii-c26/docs"
        ],
        experimental: {
          sessionMemory: true
        },
        provider: null,
        fallback: null,
        store: null,
        chunking: null,
        sync: {
          onSessionStart: true,
          onSearch: true,
          watch: true,
          watchDebounceMs: 15000,
          intervalMinutes: 0,
          sessions: {
            deltaBytes: 2048,
            deltaMessages: 4
          }
        },
        query: {
          maxResults: 8,
          minScore: 0.22,
          hybrid: {
            enabled: true,
            vectorWeight: 0.65,
            textWeight: 0.35,
            candidateMultiplier: 3,
            mmr: {
              enabled: true,
              lambda: 0.7
            },
            temporalDecay: {
              enabled: true,
              halfLifeDays: 30
            }
          }
        },
        cache: {
          enabled: true,
          maxEntries: 256
        }
      },
      compaction: {
        memoryFlush: {
          enabled: true,
          softThresholdTokens: 4000,
          prompt: "Write any lasting notes to memory/YYYY-MM-DD.md and MEMORY.md when appropriate; reply with NO_REPLY if nothing to store.",
          systemPrompt: "Session nearing compaction. Store durable memories now."
        }
      },
      models: {
        "lmstudio/google/gemma-4-e4b": {
          alias: "gemma-local",
          params: {
            reasoning: { effort: "low" }
          }
        },
        "openrouter/google/gemma-4-31b-it:free": {
          alias: "gemma-free",
          params: {
            reasoning: { effort: "low" }
          }
        },
        "openrouter/openrouter/free": {
          alias: "or-free",
          params: {
            reasoning: { effort: "low" }
          }
        },
        "openrouter/openrouter/auto": {
          alias: "or-auto"
        }
      }
    }
  },
  models: {
    mode: "merge",
    providers: {
      lmstudio: {
        baseUrl: "http://192.168.1.91:1234/v1",
        api: "openai-completions",
        timeoutSeconds: 120,
        request: {
          allowPrivateNetwork: true
        },
        models: [
          {
            id: "google/gemma-4-e4b",
            name: "Google Gemma 4 E4B",
            api: "openai-completions",
            input: ["text"]
          }
        ]
      }
    }
  },
  auth: {
    profiles: {
      "openrouter:default": {
        provider: "openrouter",
        mode: "api_key"
      }
    }
  },
  tools: {
    profile: "full",
    alsoAllow: [
      "web_search",
      "web_fetch",
      "browser",
      "browser_open",
      "screenshot",
      "http_request",
      "shell",
      "exec",
      "file_read",
      "file_write",
      "file_edit",
      "git"
    ],
    deny: [],
    exec: {
      ask: "off"
    },
    web: {
      search: {
        enabled: true,
        provider: "duckduckgo",
        maxResults: 10,
        timeoutSeconds: 20,
        openaiCodex: {
          enabled: true,
          mode: "cached",
          contextSize: "medium"
        }
      },
      fetch: {
        enabled: true,
        maxChars: 80000,
        maxCharsCap: 200000,
        maxResponseBytes: 500000,
        timeoutSeconds: 30,
        readability: true,
        maxRedirects: 5
      }
    }
  },
  memory: {
    backend: "qmd",
    citations: "auto",
    qmd: {
      command: "/home/micael/.cache/.bun/bin/qmd",
      searchMode: "search",
      includeDefaultMemory: true,
      paths: [
        {
          path: "/home/micael/Documents/2026-ei-aoopii-c26/docs",
          name: "project-docs",
          pattern: "**/*.md"
        }
      ],
      sessions: {
        enabled: true,
        retentionDays: 30,
        exportDir: "/home/micael/Documents/2026-ei-aoopii-c26/openclaw/state/qmd-sessions"
      },
      update: {
        interval: "10m",
        debounceMs: 15000,
        onBoot: true,
        waitForBootSync: false,
        startup: "idle",
        startupDelayMs: 30000,
        embedInterval: "60m",
        commandTimeoutMs: 30000,
        updateTimeoutMs: 120000,
        embedTimeoutMs: 120000
      },
      limits: {
        maxResults: 8,
        maxSnippetChars: 900,
        maxInjectedChars: 6000,
        timeoutMs: 4000
      }
    }
  },
  plugins: {
    enabled: true,
    deny: [],
    entries: {
      "browser": {
        enabled: true
      },
      "duckduckgo": {
        enabled: true,
        config: {
          webSearch: {
            region: "wt-wt",
            safeSearch: "moderate"
          }
        }
      },
      "openai": {
        enabled: true
      },
      "github-copilot": {
        enabled: true
      },
      "lmstudio": {
        enabled: true
      },
      "brave": null,
      "memory-core": {
        enabled: true
      },
      "active-memory": null,
      "memory-wiki": {
        enabled: true,
        hooks: {
          allowPromptInjection: true,
          allowConversationAccess: true,
          timeoutMs: 60000
        },
        config: {
          vaultMode: "isolated",
          vault: {
            path: "/home/micael/Documents/2026-ei-aoopii-c26/openclaw/workspace/memory-wiki",
            renderMode: "native"
          },
          ingest: {
            autoCompile: true,
            maxConcurrentJobs: 2,
            allowUrlIngest: true
          },
          search: {
            backend: "shared",
            corpus: "all"
          },
          context: {
            includeCompiledDigestPrompt: true
          },
          render: {
            preserveHumanBlocks: true,
            createBacklinks: true,
            createDashboards: true
          }
        }
      }
    },
    slots: {
      memory: "memory-core"
    }
  },
  skills: {
    allowBundled: [
      "browser-automation",
      "ddg-search",
      "github",
      "gh-issues",
      "session-logs",
      "taskflow",
      "tmux",
      "skill-creator"
    ],
    entries: {
      "proactive-self-improving-agent": {
        enabled: false
      }
    },
    load: {
      extraDirs: [
        "/home/micael/Documents/2026-ei-aoopii-c26/openclaw/workspace/skills"
      ],
      watch: true,
      watchDebounceMs: 1000
    },
    install: {
      nodeManager: "npm"
    },
    limits: {
      maxCandidatesPerRoot: 200,
      maxSkillsLoadedPerSource: 80,
      maxSkillsInPrompt: 18,
      maxSkillsPromptChars: 70000,
      maxSkillFileBytes: 500000
    }
  },
  commands: {
    text: true,
    bash: true,
    config: true,
    mcp: true,
    plugins: true,
    debug: true,
    native: "auto",
    nativeSkills: "auto",
    restart: true,
    ownerDisplay: "raw"
  },
  browser: {
    enabled: true,
    executablePath: "/usr/bin/chromium",
    headless: true,
    noSandbox: false,
    attachOnly: false,
    defaultProfile: "ei-aoopii-openclaw",
    profiles: {
      "ei-aoopii-openclaw": {
        executablePath: "/usr/bin/chromium",
        headless: true,
        driver: "openclaw",
        color: "#2563eb",
        cdpPort: 42718
      }
    }
  },
  mcp: {
    servers: {}
  }
}

# Copia este ficheiro para `.env` (já no .gitignore) e preenche.
#
# OpenRouter (LLM) — https://openrouter.ai/keys (free tier funciona)
OPENROUTER_API_KEY=

# Brave Search — opcional, desligado por defeito (DuckDuckGo é o fallback)
BRAVE_API_KEY=

# AgentMail (envio do briefing por email) — opcional, deixa em branco para desligar.
# Cria conta em https://agentmail.to, cria um inbox, copia API key e o endereço.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=intelagent@agentmail.to
BRIEFING_RECIPIENTS=
